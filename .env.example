# Copy this file to ".env" for running on your own computer.
# On Render, put these in the service's "Environment" tab instead (never commit a real .env).

# Discord bot token (Developer Portal → your app → Bot → Reset Token)
DISCORD_TOKEN=

# Your server's ID (right-click the server → Copy Server ID). Makes slash commands appear instantly.
GUILD_ID=

# Dashboard login. Anyone who knows these can open and edit the dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Random long text used to sign dashboard logins (Render can generate it).
SESSION_SECRET=

# Where data is saved. Strongly recommended on Render (free MongoDB Atlas cluster).
# Leave empty to save to data/db.json (fine locally, but WIPED on Render restarts).
MONGODB_URI=
MONGODB_DB=jianghu

# Optional: link shown by /dashboard (Render sets RENDER_EXTERNAL_URL automatically)
PUBLIC_URL=

# Optional: set to false if you don't want to enable the Message Content intent
ENABLE_MESSAGE_CONTENT=true

# Optional: set to true ONCE to reset the admin password to ADMIN_PASSWORD, then remove it.
ADMIN_RESET=false
